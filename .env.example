# Copy to .env.local. Demo mode needs none of these — `npm run dev` works as-is.
# Leave NEXT_PUBLIC_SUPABASE_URL unset (or the placeholder below) to stay in demo.

# ── Demo API (optional) ───────────────────────────────────────────────────────
# Occasional 503s on demo routes (off by default).
# DEMO_SIMULATE_ERRORS=1
# Demo APIs also apply ~100–500ms latency, 10 req/min per IP, X-Request-ID, and Cache-Control on GET.

# ── Branding (optional in demo) ───────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME=Your Property
NEXT_PUBLIC_BRAND_TAGLINE=Guest operations
# Canonical URL for Open Graph. On Vercel this falls back to the production host.
NEXT_PUBLIC_SITE_URL=https://hospitality-dashboard-theta.vercel.app

# ── Production: Supabase (required to leave demo) ─────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by cron, iCal sync, and the job worker (bypasses RLS).
# SUPABASE_SERVICE_ROLE_KEY=

# ── AI drafts (optional) ──────────────────────────────────────────────────────
# OPENAI_API_KEY=

# ── Email: campaigns + owner alerts (optional) ────────────────────────────────
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Dashboard <noreply@yourdomain.com>
# OWNER_EMAIL=

# ── Cron / internal APIs (required on Vercel production if you enable jobs) ───
# Fail-closed: production rejects these routes unless a secret is set.
# CRON_SECRET=
# INTERNAL_API_SECRET=

# ── Channel webhooks (optional; HMAC) ─────────────────────────────────────────
# WEBHOOK_SECRET_AIRBNB=
# WEBHOOK_SECRET_BOOKING=

# ── iCal feeds, one URL per room (optional) ───────────────────────────────────
# ICAL_URL_ROOM1=
# ICAL_URL_ROOM2=
# ICAL_URL_ROOM3=

# ── Maps on Settings (optional; MapLibre is the fallback) ─────────────────────
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
