// lib/domain/conflicts.ts
export function detectConflict(
  newReservation: { room: string; check_in: string; check_out: string },
  existingReservations: Reservation[]
) {
  const overlapping = existingReservations.filter(r => 
    r.room === newReservation.room &&
    r.status !== 'cancelled' &&
    !(r.check_out <= newReservation.check_in || r.check_in >= newReservation.check_out)
  );
  return overlapping;
}
